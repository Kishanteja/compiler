**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:      v0 <- 5         ;; Loading integer number 5
    store:      a_ <- v0
    iLoad:      v0 <- 1         ;; Loading integer number 1
    store:      b_ <- v0

  Label2:
    load:       v0 <- a_        ;; Loading variable a_ into register
    iLoad:      t1 <- 1         ;; Loading integer number 1
    add:        t0 <- v0 , t1
    store:      a_ <- t0
    load:       v0 <- b_        ;; Loading variable b_ into register
    iLoad:      t1 <- 2         ;; Loading integer number 2
    slt:        t0 <- v0 , t1
    not:        v0 <- t0
    bgtz:       v0 , Label1
    load:       v0 <- b_        ;; Loading variable b_ into register
    iLoad:      t1 <- 1         ;; Loading integer number 1
    add:        t0 <- v0 , t1
    store:      b_ <- t0
    goto:       Label0

  Label1:
    load:       v0 <- b_        ;; Loading variable b_ into register
    iLoad:      t1 <- 1         ;; Loading integer number 1
    sub:        t0 <- v0 , t1
    store:      b_ <- t0

  Label0:
    load:       v0 <- a_        ;; Loading variable a_ into register
    iLoad:      t1 <- 10        ;; Loading integer number 10
    slt:        t0 <- v0 , t1
    bgtz:       t0 , Label2
    iLoad:      v0 <- 1         ;; Loading 1 in v0 to indicate syscall to print integer value
    load:       a0 <- a_        ;; Moving the value to be printed into register a0
    write                       ;; This is where syscall will be made
**END: RTL Statements
