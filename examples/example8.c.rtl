**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:      v0 <- 14        ;; Loading integer number 14
    store:      x_ <- v0
    iLoad:      v0 <- 36        ;; Loading integer number 36
    store:      y_ <- v0
    load:       v0 <- x_        ;; Loading variable x_ into register
    store:      a_ <- v0
    load:       v0 <- y_        ;; Loading variable y_ into register
    store:      b_ <- v0

  Label0:
    load:       v0 <- b_        ;; Loading variable b_ into register
    iLoad:      t1 <- 0         ;; Loading integer number 0
    sne:        t0 <- v0 , t1
    not:        v0 <- t0
    bgtz:       v0 , Label1
    load:       v0 <- b_        ;; Loading variable b_ into register
    store:      t_ <- v0
    load:       v0 <- a_        ;; Loading variable a_ into register
    load:       t1 <- b_        ;; Loading variable b_ into register
    div:        t0 <- v0 , t1
    load:       t1 <- b_        ;; Loading variable b_ into register
    mul:        v0 <- t0 , t1
    store:      b_ <- v0
    load:       v0 <- t_        ;; Loading variable t_ into register
    store:      a_ <- v0
    goto:       Label0

  Label1:
    load:       v0 <- a_        ;; Loading variable a_ into register
    store:      gcd_ <- v0
    load:       v0 <- x_        ;; Loading variable x_ into register
    load:       t1 <- y_        ;; Loading variable y_ into register
    mul:        t0 <- v0 , t1
    load:       t1 <- gcd_      ;; Loading variable gcd_ into register
    div:        v0 <- t0 , t1
    store:      lcm_ <- v0
**END: RTL Statements
