Grammar

    0 $accept: program $end

    1 program: global_decl_statement_list func_def_list
    2        | func_def_list

    3 global_decl_statement_list: global_decl_statement_list func_decl
    4                           | global_decl_statement_list var_decl_stmt
    5                           | var_decl_stmt
    6                           | func_decl

    7 func_def_list: func_def_list func_def
    8              | func_def

    9 func_header: named_type NAME

   10 func_decl: func_header LEFT_ROUND_BRACKET formal_param_list RIGHT_ROUND_BRACKET SEMICOLON
   11          | func_header LEFT_ROUND_BRACKET RIGHT_ROUND_BRACKET SEMICOLON

   12 func_def: func_header LEFT_ROUND_BRACKET formal_param_list RIGHT_ROUND_BRACKET compound_statement
   13         | func_header LEFT_ROUND_BRACKET RIGHT_ROUND_BRACKET compound_statement

   14 formal_param_list: formal_param_list COMMA formal_param
   15                  | formal_param

   16 formal_param: param_type NAME

   17 param_type: INTEGER
   18           | FLOAT
   19           | STRING
   20           | BOOL

   21 var_decl_stmt: named_type var_decl_item_list SEMICOLON

   22 var_decl_item_list: var_decl_item_list COMMA NAME
   23                   | NAME

   24 named_type: INTEGER
   25           | FLOAT
   26           | STRING
   27           | BOOL
   28           | VOID

   29 compound_statement: LEFT_CURLY_BRACKET block_items RIGHT_CURLY_BRACKET

   30 block_items: block_decls block_stmts
   31            | block_decls
   32            | block_stmts
   33            | ε

   34 block_decls: block_decls var_decl_stmt
   35            | var_decl_stmt

   36 block_stmts: block_stmts statement
   37            | statement

   38 stmt_block: LEFT_CURLY_BRACKET block_stmts RIGHT_CURLY_BRACKET
   39           | LEFT_CURLY_BRACKET RIGHT_CURLY_BRACKET

   40 statement: assignment_statement
   41          | read_statement
   42          | print_statement
   43          | if_statement
   44          | while_statement
   45          | do_while_statement
   46          | return_statement
   47          | call_statement
   48          | stmt_block

   49 func_call: NAME LEFT_ROUND_BRACKET actual_arg_list RIGHT_ROUND_BRACKET

   50 actual_arg_list: non_empty_arg_list
   51                | ε

   52 non_empty_arg_list: non_empty_arg_list COMMA expression
   53                   | expression

   54 call_statement: func_call SEMICOLON

   55 return_statement: RETURN expression SEMICOLON
   56                 | RETURN SEMICOLON

   57 read_statement: READ NAME SEMICOLON

   58 print_statement: WRITE expression SEMICOLON

   59 assignment_statement: NAME ASSIGN_OP expression SEMICOLON

   60 if_statement: IF LEFT_ROUND_BRACKET expression RIGHT_ROUND_BRACKET statement
   61             | IF LEFT_ROUND_BRACKET expression RIGHT_ROUND_BRACKET statement ELSE statement

   62 while_statement: WHILE LEFT_ROUND_BRACKET expression RIGHT_ROUND_BRACKET statement

   63 do_while_statement: DO statement WHILE LEFT_ROUND_BRACKET expression RIGHT_ROUND_BRACKET SEMICOLON

   64 expression: conditional_expression

   65 conditional_expression: logical_or_expression
   66                       | logical_or_expression QUESTION_MARK expression COLON conditional_expression

   67 logical_or_expression: logical_or_expression OR logical_and_expression
   68                      | logical_and_expression

   69 logical_and_expression: logical_and_expression AND not_expression
   70                       | not_expression

   71 not_expression: NOT not_expression
   72               | equality_expression

   73 equality_expression: equality_expression EQUAL relational_expression
   74                    | equality_expression NOT_EQUAL relational_expression
   75                    | relational_expression

   76 relational_expression: relational_expression LESS additive_expression
   77                      | relational_expression GREATER additive_expression
   78                      | relational_expression GREATER_EQUAL additive_expression
   79                      | relational_expression LESS_EQUAL additive_expression
   80                      | additive_expression

   81 additive_expression: additive_expression PLUS term
   82                    | additive_expression MINUS term
   83                    | term

   84 term: term MUL factor
   85     | term DIV factor
   86     | factor

   87 factor: func_call
   88       | NAME
   89       | INT_NUM
   90       | FLOAT_NUM
   91       | STR_CONST
   92       | BOOL_CONST
   93       | LEFT_ROUND_BRACKET expression RIGHT_ROUND_BRACKET
   94       | MINUS factor


